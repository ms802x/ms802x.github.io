---
interface Props {
  name:
    | 'sun'
    | 'moon'
    | 'arrow-right'
    | 'arrow-up-right'
    | 'github'
    | 'linkedin'
    | 'x'
    | 'huggingface'
    | 'scholar'
    | 'mail'
    | 'rss'
    | 'copy'
    | 'check';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;

const strokeIcons: Record<string, string> = {
