---
import type { BlogPost } from '../lib/posts';
import { formatDate, postHref, readingTime, tagSlug } from '../lib/posts';

interface Props {
  post: BlogPost;
  index?: number;
  headingLevel?: 2 | 3;
}

const { post, index, headingLevel = 3 } = Astro.props;
const href = postHref(post);
const lang = post.data.lang;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const minutes = readingTime(post.body, lang);
const Heading = (`h${headingLevel}`) as 'h2' | 'h3';
---

<article class="post-card">
  {
    typeof index === 'number' && (
      <span class="post-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    )
  }

  <div class="post-card-body">
    <div class="post-meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes} min read</span>
      {lang === 'ar' && <span class="lang-badge" lang="ar">العربية</span>}
      {post.data.draft && <span class="draft-badge">Draft</span>}
    </div>

    <Heading class="post-card-title" lang={lang} dir={dir}>
      <a href={href}>{post.data.title}</a>
    </Heading>

    <p class="post-card-summary" lang={lang} dir={dir}>{post.data.summary}</p>

    <ul class="tag-list" aria-label="Tags">
      {
        post.data.tags.map((tag) => (
          <li>
            <a class="tag" href={`/tags/${tagSlug(tag)}/`}>{tag}</a>
          </li>
        ))
      }
    </ul>
  </div>

  <a class="post-card-arrow" href={href} aria-label={`Read ${post.data.title}`}>
    <span aria-hidden="true">↗</span>
  </a>
</article>
