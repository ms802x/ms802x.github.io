---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['neural-mesh', className]} aria-hidden="true">
  <svg viewBox="0 0 680 680" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="nm-line" x1="80" y1="340" x2="600" y2="340" gradientUnits="userSpaceOnUse">
        <stop stop-color="#5eead4" stop-opacity="0.08" />
        <stop offset="0.55" stop-color="#5eead4" stop-opacity="0.42" />
        <stop offset="1" stop-color="#fbbf24" stop-opacity="0.24" />
      </linearGradient>
      <radialGradient id="nm-node" cx="50%" cy="50%" r="50%">
        <stop stop-color="#d9fff8" />
        <stop offset="0.35" stop-color="#5eead4" />
        <stop offset="1" stop-color="#0f766e" stop-opacity="0" />
      </radialGradient>
      <filter id="nm-glow" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="5" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <g class="nm-links" stroke="url(#nm-line)" stroke-width="1">
      <path d="M96 250 236 178M96 250 236 250M96 250 236 322M96 250 236 394M96 322 236 178M96 322 236 250M96 322 236 322M96 322 236 394M96 394 236 250M96 394 236 322M96 394 236 394M96 394 236 466" />
      <path d="M252 178 410 216M252 178 410 300M252 178 410 384M252 250 410 216M252 250 410 300M252 250 410 384M252 322 410 216M252 322 410 300M252 322 410 384M252 394 410 216M252 394 410 300M252 394 410 384M252 466 410 300M252 466 410 384" />
      <path d="M426 216 560 268M426 216 560 348M426 300 560 268M426 300 560 348M426 384 560 268M426 384 560 348" />
    </g>

    <g class="nm-active-links" stroke="#5eead4" stroke-width="1.5" stroke-linecap="round">
      <path d="M96 322 236 250 410 300 560 348" />
      <path d="M96 250 236 394 410 216 560 268" />
      <path d="M96 394 236 322 410 384 560 348" />
    </g>

    <g class="nm-nodes" fill="url(#nm-node)" filter="url(#nm-glow)">
      <circle class="nm-node-pulse" cx="96" cy="250" r="5" />
      <circle cx="96" cy="322" r="8" />
      <circle class="nm-node-pulse" cx="96" cy="394" r="4" />
      <circle cx="236" cy="178" r="4" />
      <circle class="nm-node-pulse" cx="236" cy="250" r="7" />
      <circle cx="236" cy="322" r="5" />
      <circle cx="236" cy="394" r="4" />
      <circle class="nm-node-pulse" cx="236" cy="466" r="3" />
      <circle cx="410" cy="216" r="4" />
      <circle cx="410" cy="300" r="8" />
      <circle class="nm-node-pulse" cx="410" cy="384" r="4" />
      <circle cx="560" cy="268" r="4" />
      <circle cx="560" cy="348" r="7" />
    </g>

    <g class="nm-rings" stroke="#5eead4" stroke-opacity="0.2">
      <circle cx="410" cy="300" r="24" />
      <circle cx="410" cy="300" r="42" stroke-opacity="0.08" />
      <circle cx="96" cy="322" r="18" />
    </g>

    <g class="nm-labels" fill="#8db3ad" font-family="'JetBrains Mono', monospace" font-size="10" letter-spacing="2">
      <text x="72" y="492">ENCODE</text>
      <text x="218" y="492">ATTEND</text>
      <text x="390" y="492">LATENT</text>
      <text x="544" y="492">DECODE</text>
    </g>

    <g fill="#5eead4" opacity="0.3">
      <circle cx="320" cy="92" r="1.5" />
      <circle cx="612" cy="154" r="1.5" />
      <circle cx="512" cy="586" r="1.5" />
      <circle cx="154" cy="570" r="1.5" />
    </g>
  </svg>
</div>
