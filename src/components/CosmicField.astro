---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['cosmic-field', className]} aria-hidden="true">
  <svg
    class="cosmic-svg"
    viewBox="0 0 1440 900"
    preserveAspectRatio="xMidYMid slice"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <radialGradient id="cosmos-core" cx="50%" cy="50%" r="50%">
        <stop stop-color="#b8fff4" />
        <stop offset="0.22" stop-color="#5eead4" stop-opacity="0.85" />
        <stop offset="0.55" stop-color="#14b8a6" stop-opacity="0.2" />
        <stop offset="1" stop-color="#0f766e" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="cosmos-link" x1="700" y1="250" x2="1320" y2="650" gradientUnits="userSpaceOnUse">
        <stop stop-color="#5eead4" stop-opacity="0.05" />
        <stop offset="0.5" stop-color="#5eead4" stop-opacity="0.42" />
        <stop offset="1" stop-color="#a5b4fc" stop-opacity="0.16" />
      </linearGradient>
      <linearGradient id="cosmos-link-soft" x1="760" y1="650" x2="1360" y2="200" gradientUnits="userSpaceOnUse">
        <stop stop-color="#a5b4fc" stop-opacity="0.04" />
        <stop offset="0.55" stop-color="#a5b4fc" stop-opacity="0.22" />
        <stop offset="1" stop-color="#5eead4" stop-opacity="0.12" />
      </linearGradient>
      <filter id="cosmos-glow" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="4" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
      <filter id="cosmos-star-glow" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="2.5" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
      <radialGradient id="cosmos-nebula" cx="50%" cy="50%" r="50%">
        <stop stop-color="#2dd4bf" stop-opacity="0.09" />
        <stop offset="1" stop-color="#2dd4bf" stop-opacity="0" />
      </radialGradient>
    </defs>

    <ellipse cx="1080" cy="420" rx="470" ry="330" fill="url(#cosmos-nebula)" />

    <g class="cosmos-stars">
      <circle cx="94" cy="116" r="1.2" opacity=".48" />
      <circle cx="178" cy="278" r="0.8" opacity=".3" />
      <circle cx="248" cy="84" r="1" opacity=".55" />
      <circle cx="326" cy="194" r="1.4" opacity=".38" />
      <circle cx="408" cy="120" r="0.7" opacity=".55" />
      <circle cx="482" cy="312" r="1" opacity=".28" />
      <circle cx="552" cy="84" r="1.3" opacity=".4" />
      <circle cx="646" cy="216" r="0.8" opacity=".34" />
      <circle cx="720" cy="126" r="1.5" opacity=".5" />
      <circle cx="804" cy="300" r="1" opacity=".24" />
      <circle cx="864" cy="88" r="0.8" opacity=".5" />
      <circle cx="938" cy="184" r="1.2" opacity=".32" />
      <circle cx="1042" cy="94" r="0.8" opacity=".48" />
      <circle cx="1128" cy="180" r="1.4" opacity=".28" />
      <circle cx="1218" cy="112" r="0.9" opacity=".42" />
      <circle cx="1328" cy="164" r="1.2" opacity=".3" />
      <circle cx="1392" cy="86" r="0.8" opacity=".42" />
      <circle cx="118" cy="436" r="0.7" opacity=".3" />
      <circle cx="216" cy="552" r="1.2" opacity=".22" />
      <circle cx="306" cy="702" r="0.8" opacity=".34" />
      <circle cx="412" cy="624" r="1.3" opacity=".2" />
      <circle cx="518" cy="782" r="0.8" opacity=".3" />
      <circle cx="638" cy="656" r="1" opacity=".24" />
      <circle cx="746" cy="804" r="1.2" opacity=".28" />
      <circle cx="856" cy="674" r="0.8" opacity=".24" />
      <circle cx="962" cy="788" r="1.1" opacity=".24" />
      <circle cx="1084" cy="694" r="0.8" opacity=".3" />
      <circle cx="1192" cy="806" r="1.2" opacity=".25" />
      <circle cx="1314" cy="706" r="0.8" opacity=".26" />
      <circle cx="1398" cy="806" r="1" opacity=".24" />
      <circle cx="88" cy="820" r="0.8" opacity=".2" />
      <circle cx="340" cy="362" r="0.6" opacity=".4" />
      <circle cx="676" cy="468" r="0.7" opacity=".3" />
      <circle cx="1002" cy="518" r="0.7" opacity=".3" />
      <circle cx="1360" cy="462" r="0.7" opacity=".35" />
    </g>

    <g class="cosmos-orbits" stroke="#5eead4" fill="none">
      <ellipse cx="1080" cy="410" rx="282" ry="198" stroke-opacity=".09" stroke-dasharray="1 8" />
      <ellipse cx="1080" cy="410" rx="360" ry="254" stroke-opacity=".055" />
      <path d="M820 188c178-90 392-22 490 150" stroke-opacity=".08" stroke-dasharray="2 9" />
      <path d="M756 604c194 108 430 54 560-106" stroke-opacity=".06" />
    </g>

    <g class="cosmos-links" stroke="url(#cosmos-link)" stroke-width="1">
      <path d="M772 306 884 240 1014 294 1080 410 1186 334 1288 392" />
      <path d="M884 240 946 372 1014 294 1080 410 1144 520 1288 392" />
      <path d="M772 306 842 436 946 372 1080 410 1186 334 1314 470" />
      <path d="M842 436 940 618 1080 410 1144 520 1292 602" />
      <path d="M1014 294 1144 520 1186 334 1314 470 1292 602" />
    </g>

    <g class="cosmos-links-soft" stroke="url(#cosmos-link-soft)" stroke-width="0.8">
      <path d="M648 450 772 306 1014 294 1144 520 1292 602" />
      <path d="M648 450 842 436 946 372 1080 410 1186 334 1314 470" />
      <path d="M710 190 772 306 884 240 1014 294" />
      <path d="M932 690 940 618 1080 410 1288 392 1314 470" />
    </g>

    <g class="cosmos-signals" stroke="#5eead4" stroke-width="1.4" stroke-linecap="round">
      <path d="M772 306 884 240 1014 294 1080 410 1144 520 1292 602" />
      <path d="M842 436 946 372 1080 410 1186 334 1314 470" />
      <path d="M648 450 772 306 1014 294 1144 520" />
    </g>

    <g class="cosmos-nodes">
      <circle class="cosmos-pulse" cx="772" cy="306" r="5" />
      <circle cx="884" cy="240" r="3.5" />
      <circle class="cosmos-pulse" cx="1014" cy="294" r="4.5" />
      <circle class="cosmos-core" cx="1080" cy="410" r="8" />
      <circle cx="1186" cy="334" r="3" />
      <circle class="cosmos-pulse" cx="1144" cy="520" r="4" />
      <circle cx="1288" cy="392" r="3.5" />
      <circle class="cosmos-pulse" cx="842" cy="436" r="3.5" />
      <circle cx="946" cy="372" r="2.8" />
      <circle cx="1314" cy="470" r="2.5" />
      <circle class="cosmos-pulse" cx="1292" cy="602" r="3.5" />
      <circle cx="648" cy="450" r="2.5" />
      <circle cx="940" cy="618" r="2.5" />
      <circle cx="710" cy="190" r="2" />
      <circle cx="932" cy="690" r="2" />
    </g>

    <g class="cosmos-core-ring" stroke="#5eead4">
      <circle cx="1080" cy="410" r="20" stroke-opacity=".24" />
      <circle cx="1080" cy="410" r="36" stroke-opacity=".09" />
      <circle cx="1080" cy="410" r="62" stroke-opacity=".035" stroke-dasharray="1 7" />
    </g>

    <g fill="#d6fff8">
      <circle cx="238" cy="188" r="1.8" opacity=".9" />
      <circle cx="704" cy="104" r="1.4" opacity=".75" />
      <circle cx="1340" cy="606" r="1.6" opacity=".7" />
      <circle cx="1010" cy="748" r="1.4" opacity=".55" />
    </g>
  </svg>
</div>
