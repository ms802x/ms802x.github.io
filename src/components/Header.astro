---
import { NAV, SITE } from '../consts';
import Icon from './Icon.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href);
---

<header class="site-header" lang="en">
  <div class="shell header-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">A<span>.</span></span>
      <span class="brand-text">
        <span class="brand-name">{SITE.brand}</span>
        <span class="brand-role">{SITE.role}</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      {NAV.map((item) => (
        <a
          class:list={['nav-link', { active: isActive(item.href) }]}
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a class="nav-link nav-rss" href="/rss.xml" aria-label="RSS feed">
        <Icon name="rss" size={15} />
      </a>
    </nav>

    <button
      id="theme-toggle"
      class="theme-toggle"
      type="button"
      aria-label="Switch to dark theme"
      title="Toggle colour theme"
    >
      <span class="theme-icon theme-icon-sun"><Icon name="sun" size={17} /></span>
      <span class="theme-icon theme-icon-moon"><Icon name="moon" size={17} /></span>
    </button>
  </div>
</header>
