---
import { NAV, SITE } from '../consts';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' || pathname.startsWith('/blog/') : pathname.startsWith(href);
---

<header class="site-header" lang="en">
  <div class="shell header-inner">
    <a class="brand" href="/">{SITE.author}</a>
    <nav class="site-nav" aria-label="Primary navigation">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <button id="theme-toggle" class="theme-toggle" type="button">Dark</button>
    </nav>
  </div>
</header>
