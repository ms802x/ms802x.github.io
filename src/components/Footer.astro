---
import { NAV, SITE } from '../consts';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer" lang="en">
  <div class="shell footer-grid">
    <div class="footer-intro">
      <a class="brand brand-footer" href="/">
        <span class="brand-mark" aria-hidden="true">A<span>.</span></span>
        <span class="brand-text">
          <span class="brand-name">{SITE.brand}</span>
          <span class="brand-role">{SITE.role}</span>
        </span>
      </a>
      <p>
        Personal profile and notes on building, measuring, and shipping AI systems. Based in
        Saudi Arabia.
      </p>
    </div>

    <div class="footer-column">
      <p class="footer-label">Explore</p>
      <nav aria-label="Footer navigation">
        <ul class="footer-links">
          <li><a href="/blog/">Writing</a></li>
          {NAV.filter((item) => item.href !== '/blog/').map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href="/rss.xml">RSS feed</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-column">
      <p class="footer-label">Elsewhere</p>
      <SocialLinks />
    </div>
  </div>

  <div class="shell footer-bottom">
    <p>© {year} {SITE.shortTitle}. Built with Astro. No trackers.</p>
    <a class="back-to-top" href="#top">
      Back to top <Icon name="arrow-up-right" size={14} />
    </a>
  </div>
</footer>
