---
import BaseLayout from './BaseLayout.astro';
import 'katex/dist/katex.min.css';
import { GISCUS, GISCUS_ENABLED, SITE } from '../consts';
import type { BlogPost } from '../lib/posts';
import { formatDate, formatDateISO, postHref, readingTime, tagSlug } from '../lib/posts';

interface Props {
  post: BlogPost;
  newer?: BlogPost;
  older?: BlogPost;
}

const { post, newer, older } = Astro.props;
const lang = post.data.lang;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const minutes = readingTime(post.body, lang);
const siteURL = (Astro.site ?? new URL(SITE.fallbackUrl)).href.replace(/\/$/, '');
const postURL = `${siteURL}${postHref(post)}`;
const share = {
  x: `https://x.com/intent/post?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(postURL)}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postURL)}`,
  hn: `https://news.ycombinator.com/submitlink?u=${encodeURIComponent(postURL)}&t=${encodeURIComponent(post.data.title)}`,
};
const replyHref = `mailto:${SITE.email}?subject=${encodeURIComponent(`Re: ${post.data.title}`)}`;
const canonicalHost = post.data.canonical_url ? new URL(post.data.canonical_url).hostname : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.summary,
  datePublished: formatDateISO(post.data.date),
  dateModified: formatDateISO(post.data.date),
  inLanguage: lang,
  keywords: post.data.tags.join(', '),
  author: {
    '@type': 'Person',
    name: SITE.author,
    jobTitle: SITE.role,
    url: siteURL,
  },
  publisher: {
    '@type': 'Person',
    name: SITE.author,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postURL,
  },
  image: new URL('/og-default.png', `${siteURL}/`).href,
  isAccessibleForFree: true,
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  type="article"
  lang={lang}
  canonical={post.data.canonical_url}
  publishedTime={post.data.date}
  modifiedTime={post.data.date}
  jsonLd={jsonLd}
>
  <article lang={lang}>
    <header class="post-header" dir={dir}>
      <h1>{post.data.title}</h1>
      <p class="summary">{post.data.summary}</p>
      <div class="meta" lang="en" dir="ltr">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {' · '}{minutes} min read
        {post.data.tags.map((tag) => (
          <>
            {' · '}
            <a href={`/tags/${tagSlug(tag)}/`}>{tag}</a>
          </>
        ))}
        {post.data.draft && <span class="draft">Draft</span>}
      </div>
    </header>

    <div class="prose" dir={dir}>
      <slot />
    </div>

    {post.data.canonical_url && (
      <p class="meta">
        Originally published at <a href={post.data.canonical_url}>{canonicalHost}</a>.
      </p>
    )}

    <footer class="post-end" lang="en" dir="ltr">
      <p>
        Questions, corrections, or a different result on your setup?{' '}
        <a href={replyHref}>Reply by email</a>{GISCUS_ENABLED && ' or leave a comment below'}.
      </p>
      <div class="row meta">
        <span>Share:</span>
        <button type="button" id="copy-link" data-url={postURL}>Copy link</button>
        <a href={share.x} target="_blank" rel="noopener noreferrer">X</a>
        <a href={share.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={share.hn} target="_blank" rel="noopener noreferrer">Hacker News</a>
      </div>
    </footer>

    {GISCUS_ENABLED && <div class="comments giscus" />}

    {(newer || older) && (
      <nav class="post-nav" aria-label="More posts" lang="en">
        {older ? <a href={postHref(older)}>← {older.data.title}</a> : <span />}
        {newer ? <a href={postHref(newer)}>{newer.data.title} →</a> : <span />}
      </nav>
    )}
  </article>

  <script>
    const copy = document.getElementById('copy-link');
    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.url ?? location.href);
        copy.textContent = 'Copied';
      } catch {
        copy.textContent = 'Copy failed';
      }
      setTimeout(() => (copy.textContent = 'Copy link'), 1800);
    });
  </script>

  {GISCUS_ENABLED && (
    <script is:inline define:vars={{ giscus: GISCUS }}>
      const giscusTheme = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
      const s = document.createElement('script');
      s.src = 'https://giscus.app/client.js';
      s.async = true;
      s.crossOrigin = 'anonymous';
      Object.entries({
        repo: giscus.repo,
        'repo-id': giscus.repoId,
        category: giscus.category,
        'category-id': giscus.categoryId,
        mapping: 'pathname',
        strict: '1',
        'reactions-enabled': '1',
        'input-position': 'top',
        theme: giscusTheme(),
        lang: 'en',
        loading: 'lazy',
      }).forEach(([key, value]) => s.setAttribute(`data-${key}`, value));
      document.querySelector('.giscus')?.appendChild(s);

      // Keep comments in sync with the theme toggle.
      new MutationObserver(() => {
        document
          .querySelector('iframe.giscus-frame')
          ?.contentWindow?.postMessage({ giscus: { setConfig: { theme: giscusTheme() } } }, 'https://giscus.app');
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    </script>
  )}
</BaseLayout>
