---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTags } from '../../lib/posts';

const tags = getTags(await getPosts());
---

<BaseLayout title="Topics" description="All topics covered on the blog.">
  <section class="page">
    <h1>Topics</h1>
    <ul>
      {tags.map((tag) => (
        <li>
          <a href={`/tags/${tag.slug}/`}>{tag.name}</a> <span class="meta">({tag.count})</span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
