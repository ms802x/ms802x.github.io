---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import type { BlogPost } from '../../lib/posts';
import { getPosts, getTags, tagSlug } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = getTags(posts);

  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: {
      tagName: tag.name,
      posts: posts.filter((post) => post.data.tags.some((name) => tagSlug(name) === tag.slug)),
    },
  }));
}

interface Props {
  tagName: string;
  posts: BlogPost[];
}

const { tagName, posts } = Astro.props;
---

<BaseLayout title={tagName} description={`Posts about ${tagName}.`}>
  <section class="page">
    <p class="meta"><a href="/tags/">Topics</a></p>
    <h1>{tagName}</h1>
    <PostList posts={posts} />
  </section>
</BaseLayout>
