---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const experience = [
  {
    role: 'Lead AI Engineer',
    company: 'HUMAIN',
    location: 'Riyadh, Saudi Arabia',
    dates: 'May 2025 – Present',
    bullets: [
      'Built the in-house avatar video models, adapting architectures from published research: a half-body generation model distilled to few-step generation with DMD and Self Forcing, running in real time (25 fps, 720p) on a single NVIDIA L4, and a face-inpainting model serving 5+ concurrent streams per L4.',
      'Optimized a compact avatar model to run on-device on the HUMAIN laptop NPU; deployed on-device models on mobile phones.',
      'Pretrained and fine-tuned video diffusion models for custom avatar generation; optimized inference for both GPU and CPU deployment.',
      'Fine-tuned LLMs with LoRA (Gemma E2B, E4B, and 31B) and optimized inference serving to reach 1.5 s end-to-end latency for the conversational avatar.',
      'Developed real-time AI avatar agents (virtual presenters, meeting facilitators) with STT → LLM → TTS pipelines.',
      'Built an agent-name-agnostic binary intent classifier (99% accuracy) to route user requests within the conversational pipeline.',
    ],
  },
  {
    role: 'AI Engineer',
    company: 'SDAIA',
    location: 'Saudi Arabia',
    dates: 'Jun 2024 – May 2025',
    bullets: [
      'Fine-tuned LoRA modules for image and video diffusion models (Flux, Hunyuan, Wan 2.1).',
      'Fine-tuned LLaMA and T5 for token-by-token image generation/understanding and conversational abilities.',
      'Optimized inference with TensorRT (vision models), vLLM (LLMs), and TeaCache (diffusion).',
      'Built multi-GPU / multi-node training pipelines with Hugging Face Accelerate and DeepSpeed.',
      'Built a sign-language-to-text translation system with T5 and AV-HuBERT (Sign4All Challenge).',
      'Trained DETR and YOLO detectors for construction-site surveillance (helmets, vehicles, license plates, people).',
    ],
  },
  {
    role: 'Solar Energy Systems Researcher',
    company: 'KAUST',
    location: 'Saudi Arabia',
    dates: 'Aug 2022 – May 2024',
    bullets: [
      'Developed a single-voltage-sensor fault-localization method for PV systems with the KAUST Solar Center; tested solar-glass technologies with NEOM.',
    ],
  },
];

const education = [
  {
    school: 'King Abdullah University of Science and Technology (KAUST)',
    location: 'Thuwal, Saudi Arabia',
    degree: 'M.Sc., Electrical and Computer Engineering',
    detail: 'Specialization in Solar Energy Systems · GPA: 3.67/4.0',
    dates: 'Jun 2024',
    thesis:
      'Thesis: “A Novel Fault Localization Technique for PV Systems Using a Single-Voltage Sensor.” Advisor: Prof. Shehab Ahmed.',
  },
  {
    school: 'King Fahd University of Petroleum and Minerals (KFUPM)',
    location: 'Dhahran, Saudi Arabia',
    degree: 'B.Sc., Electrical Engineering',
    detail: 'Specialization in Internet of Things · GPA: 3.75/4.0',
    dates: 'May 2022',
    thesis:
      'Research: “Optimized Synthesis Algorithm for a Two-Phase Switched-Capacitor Converter.” Advisor: Dr. Yaqub Mahnashi.',
  },
];

const publications = [
  {
    authors: 'A. Alhejab et al.',
    year: '2026',
    title: 'Saudi Sign Language Translation Using T5',
    venue: 'Springer, Cham',
  },
  {
    authors: 'A. Alhejab, M. Abbasi, S. Ahmed',
    year: '2025',
    title: 'A Single-Voltage-Sensor Bypass-Switch-Based Photovoltaic Fault Localization',
    venue: 'IEEE Journal of Photovoltaics',
  },
  {
    authors: 'O. Khalifa, A. S. Mohammed, A. Alhejab, et al.',
    year: '2024',
    title: 'Energy-Efficient Aerial Data Aggregation for IoT: From Prototyping to Large-Scale Implementation',
    venue: 'IEEE Transactions on Instrumentation and Measurement',
  },
  {
    authors: 'A. S. Mohammed, O. Khalifa, A. Alhejab, et al.',
    year: '2023',
    title: 'Energy-Efficient Aerial Data Aggregation in IoT Networks with WuR',
    venue: 'IEEE International Black Sea Conference on Communications and Networking',
  },
  {
    authors: 'A. Alhejab, Y. Mahnashi',
    year: '2024',
    title: 'A New Synthesis Method for Efficient Reconfigurable Switched-Capacitor Converters',
    venue: 'Authorea Preprints',
  },
];

const certifications = [
  {
    title: 'NVIDIA Certified Associate — Generative AI (Multimodal) & Generative AI (LLM)',
    detail: 'Dec 2024',
  },
  {
    title: 'Self-Driving Car Engineer Nanodegree (Misk-sponsored)',
    detail: 'Jun–Oct 2021',
  },
];

const skills = [
  { label: 'Generative models', value: 'Video and image diffusion (Flux, Hunyuan, Wan 2.1); few-step distillation (DMD / DMD2); Self Forcing for autoregressive video; LoRA fine-tuning; inpainting' },
  { label: 'LLMs', value: 'Gemma, LLaMA, T5, LoRA fine-tuning, LLaMA-Factory, vLLM, real-time STT → LLM → TTS agents' },
  { label: 'Efficient inference', value: 'TensorRT, vLLM, TeaCache, torch.compile, FlashAttention, real-time GPU serving (NVIDIA L4), CPU inference' },
  { label: 'Edge AI', value: 'On-device deployment (laptop NPU, mobile); ONNX Runtime, Qualcomm QNN / AI Hub, OpenVINO; quantization, pruning, distillation' },
  { label: 'Training', value: 'PyTorch, Hugging Face, Accelerate, DeepSpeed (multi-GPU / multi-node)' },
  { label: 'Vision', value: 'DETR, YOLO, AV-HuBERT' },
  { label: 'Languages', value: 'Python, C/C++ · Arabic (native), English (advanced)' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ali A. Alhejab',
  jobTitle: 'Lead AI Engineer',
  email: `mailto:${SITE.email}`,
  url: 'https://ms802x.github.io/',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Riyadh',
    addressCountry: 'SA',
  },
  worksFor: {
    '@type': 'Organization',
    name: 'HUMAIN',
  },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'King Abdullah University of Science and Technology' },
    { '@type': 'CollegeOrUniversity', name: 'King Fahd University of Petroleum and Minerals' },
  ],
  sameAs: [SITE.github, SITE.x, SITE.scholar],
  knowsAbout: [
    'Large language models',
    'Agentic AI',
    'Image generation',
    'Video generation',
    'Diffusion models',
    'Computer vision',
    'Deep learning',
    'Inference optimization',
    'Edge AI',
  ],
};
---

<BaseLayout
  title="CV"
  description="CV of Ali A. Alhejab, Lead AI Engineer at HUMAIN: generative video and image models, LLMs, and edge AI."
  jsonLd={jsonLd}
>
  <section class="page">
    <h1>Ali A. Alhejab</h1>
    <p class="meta">
      Lead AI Engineer · {SITE.location} ·{' '}
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a> ·{' '}
      <a href={SITE.github}>github.com/ms802x</a> ·{' '}
      <a href={SITE.scholar}>Google Scholar</a>
      <span class="no-print">
        {' · '}<a href="/cv/Ali-Alhejab-CV.pdf" download>PDF</a>
      </span>
    </p>

    <p>
      AI engineer focused on generative video and image models, LLMs, and edge AI. I build real-time
      avatar video models (few-step distillation with DMD and Self Forcing), optimize models for
      on-device inference on laptop NPUs and mobile, and build the LLM pipelines behind avatar
      agents with 1.5 s end-to-end latency.
    </p>

    <h2>Experience</h2>
    {experience.map((job) => (
      <div class="cv-entry">
        <div class="cv-entry-head">
          <h3>{job.role}, {job.company}</h3>
          <span class="meta">{job.dates}</span>
        </div>
        <p class="meta">{job.location}</p>
        <ul>
          {job.bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
      </div>
    ))}

    <h2>Skills</h2>
    <ul>
      {skills.map((skill) => (
        <li><strong>{skill.label}:</strong> {skill.value}</li>
      ))}
    </ul>

    <h2>Education</h2>
    {education.map((entry) => (
      <div class="cv-entry">
        <div class="cv-entry-head">
          <h3>{entry.degree}</h3>
          <span class="meta">{entry.dates}</span>
        </div>
        <p class="meta">{entry.school} · {entry.location}</p>
        <p>{entry.detail}. {entry.thesis}</p>
      </div>
    ))}

    <h2>Publications</h2>
    <ol>
      {publications.map((publication) => (
        <li>
          {publication.authors.replace(/\.$/, '')}. “{publication.title}.” <em>{publication.venue}</em>,{' '}
          {publication.year}.
        </li>
      ))}
    </ol>
    <p class="meta no-print">
      Most current record on <a href={SITE.scholar}>Google Scholar</a>.
    </p>

    <h2>Honors</h2>
    <ul>
      <li>
        1st Place, Abu Dhabi University 11th Research Competition, 2023. Optimized Synthesis
        Algorithm for a Two-Phase Switched-Capacitor Converter.
      </li>
      <li>
        1st Place, KFUPM Senior Design Project EXPO, 2022. Low-Power IoT Data Aggregation System
        Using a UAV as Data Aggregator.
      </li>
    </ul>

    <h2>Certifications</h2>
    <ul>
      {certifications.map((certificate) => (
        <li>{certificate.title}. <span class="meta">{certificate.detail}</span></li>
      ))}
    </ul>


    <h2>Mentoring</h2>
    <ul>
      <li>Mentor, KAUST AI Academy (Deep Learning, Reinforcement Learning), 2023–2024.</li>
    </ul>
  </section>
</BaseLayout>
