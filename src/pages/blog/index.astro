---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, getTags } from '../../lib/posts';

const posts = await getPosts();
const tags = getTags(posts);
---

<BaseLayout title="Writing" description="Notes on AI engineering: agents, generative media, and efficient inference.">
  <section class="page">
    <h1>Writing</h1>
    {tags.length > 0 && (
      <nav class="tag-filter" aria-label="Topics">
        <a href="/blog/" aria-current="page">All</a>
        {tags.map((tag) => <a href={`/tags/${tag.slug}/`}>{tag.name}</a>)}
      </nav>
    )}
    <PostList posts={posts} />
  </section>
</BaseLayout>
