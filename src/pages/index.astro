---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
---

<BaseLayout>
  <section class="intro">
    <h1>Ali Alhejab</h1>
    <p>
      Lead AI Engineer at HUMAIN. Notes on agents, diffusion models, and making inference fast:
      what I measured, what broke, and what I'd do differently.
    </p>
  </section>

  <h2 class="list-heading">Writing</h2>
  <PostList posts={posts} />
</BaseLayout>
