---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { FOCUS_AREAS, SITE } from '../consts';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 4);
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">AI Engineer · {SITE.location}</p>
        <h1 class="hero-title">
          I build AI systems that <span class="accent">hold up</span> in production.
        </h1>
        <p class="hero-lede">
          I'm <strong>Ali Alhejab</strong>, an AI engineer with about four years of hands-on ML, NLP, and LLM
          engineering experience. This is my personal profile: my work centers on generative
          imaging, diffusion models, inference optimization, knowledge distillation, and Arabic
          ASR/NLP — with an emphasis on how those systems perform once the notebook is gone.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/blog/">
            Read the writing <Icon name="arrow-right" size={16} />
          </a>
          <a class="button button-ghost" href="/about/">About me</a>
        </div>
        <p class="hero-note">
          <span class="dot" aria-hidden="true"></span>
          Deployed models on H100 and B300 · MSc, KAUST
        </p>
      </div>

      <aside class="spec-card" aria-label="Profile at a glance">
        <div class="spec-top">
          <span class="spec-top-label">Profile</span>
          <span class="spec-year">{new Date().getFullYear()}</span>
        </div>
        <dl class="spec-list">
          <div class="spec-item">
            <dt>Focus</dt>
            <dd>Diffusion models · inference · distillation · Arabic NLP</dd>
          </div>
          <div class="spec-item">
            <dt>Hardware</dt>
            <dd>H100 · B300 (Blackwell Ultra)</dd>
          </div>
          <div class="spec-item">
            <dt>Education</dt>
            <dd>MSc, King Abdullah University of Science and Technology</dd>
          </div>
          <div class="spec-item">
            <dt>Based in</dt>
            <dd>{SITE.location}</dd>
          </div>
        </dl>
        <div class="spec-footer">
          <span class="spec-chip">NVIDIA certified</span>
          <span class="spec-chip">IEEE + Springer</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="facts" aria-label="Quick facts">
    <div class="shell facts-grid">
      <div class="fact">
        <span class="fact-value">~4 years</span>
        <span class="fact-label">ML / NLP / LLM</span>
      </div>
      <div class="fact">
        <span class="fact-value">MSc</span>
        <span class="fact-label">KAUST</span>
      </div>
      <div class="fact">
        <span class="fact-value">NVIDIA</span>
        <span class="fact-label">Certified</span>
      </div>
      <div class="fact">
        <span class="fact-value">IEEE + Springer</span>
        <span class="fact-label">Published research</span>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="latest-heading">
    <div class="shell">
      <div class="section-head">
        <div class="section-head-copy">
          <p class="section-label">Latest writing</p>
          <h2 class="section-title" id="latest-heading">Notes from the build.</h2>
        </div>
        <a class="section-link" href="/blog/">All posts <Icon name="arrow-right" size={14} /></a>
      </div>

      {
        latest.length > 0 ? (
          <div class="post-list">
            {latest.map((post, index) => (
              <PostCard post={post} index={index} />
            ))}
          </div>
        ) : (
          <p class="empty-state">No posts yet. Check back soon.</p>
        )
      }
    </div>
  </section>

  <section class="section section-bordered" aria-labelledby="focus-heading">
    <div class="shell">
      <div class="section-head">
        <div class="section-head-copy">
          <p class="section-label">Focus</p>
          <h2 class="section-title" id="focus-heading">Where the work happens.</h2>
        </div>
        <a class="section-link" href="/about/">More about me <Icon name="arrow-right" size={14} /></a>
      </div>

      <div class="focus-grid">
        {
          FOCUS_AREAS.map((area, index) => (
            <article class="focus-card">
              <span class="focus-number">{String(index + 1).padStart(2, '0')}</span>
              <h3>{area.title}</h3>
              <p>{area.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
