---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../consts';

const publications = [
  {
    publisher: 'Springer',
    title: 'Saudi Sign Language Translation Using T5',
    authors: 'A. Alhejab et al.',
    venue: 'Springer, Cham',
    year: '2026',
    area: 'Sign language · NLP',
  },
  {
    publisher: 'IEEE',
    title: 'A Single-Voltage-Sensor Bypass-Switch-Based Photovoltaic Fault Localization',
    authors: 'A. Alhejab, M. Abbasi, S. Ahmed',
    venue: 'IEEE Journal of Photovoltaics',
    year: '2025',
    area: 'Photovoltaics · Fault detection',
  },
  {
    publisher: 'IEEE',
    title:
      'Energy-Efficient Aerial Data Aggregation for IoT: From Prototyping to Large-Scale Implementation',
    authors: 'O. Khalifa, A. S. Mohammed, A. Alhejab, et al.',
    venue: 'IEEE Transactions on Instrumentation and Measurement',
    year: '2024',
    area: 'IoT · Aerial systems',
  },
  {
    publisher: 'IEEE',
    title: 'Energy-Efficient Aerial Data Aggregation in IoT Networks with WuR',
    authors: 'A. S. Mohammed, O. Khalifa, A. Alhejab, et al.',
    venue: 'IEEE International Black Sea Conference on Communications and Networking',
    year: '2023',
    area: 'IoT · Wireless networks',
  },
  {
    publisher: 'Authorea',
    title: 'A New Synthesis Method for Efficient Reconfigurable Switched-Capacitor Converters',
    authors: 'A. Alhejab, Y. Mahnashi',
    venue: 'Authorea Preprints',
    year: '2024',
    area: 'Power electronics',
  },
];
---

<BaseLayout
  title="Publications"
  description="Selected peer-reviewed publications by Ali Alhejab across AI, NLP, photovoltaics, IoT, and power electronics."
>
  <header class="page-header">
    <div class="shell page-header-grid">
      <div>
        <p class="page-kicker eyebrow">Research</p>
        <h1 class="page-title">Publications.</h1>
      </div>
      <p class="page-lede">
        Selected work spanning generative AI and sign-language translation, photovoltaic fault
        localization, energy-efficient IoT, and reconfigurable power converters.
      </p>
    </div>
  </header>

  <div class="shell">
    <div class="publications-list">
      {
        publications.map((publication, index) => (
          <article class="publication-card">
            <span class="publication-publisher">{publication.publisher}</span>
            <div class="publication-main">
              <div class="publication-meta">
                <span>{publication.area}</span>
                <span>{publication.year}</span>
              </div>
              <h3>{publication.title}</h3>
              <p>{publication.authors}</p>
              <div class="publication-meta">
                <span>{publication.venue}</span>
              </div>
            </div>
            <span class="publication-index">0{index + 1}</span>
          </article>
        ))
      }

      <p class="publication-note">
        Full citations are available in my <a class="text-link" href="/cv/">CV</a>. For the most
        current record, see <a class="text-link" href={SITE.scholar}>Google Scholar</a>.
      </p>

      <div class="hero-actions">
        <a class="button button-primary" href={SITE.scholar} target="_blank" rel="noopener noreferrer">
          Google Scholar <Icon name="arrow-up-right" size={16} />
        </a>
        <a class="button button-ghost" href="/cv/">View CV</a>
      </div>
    </div>
  </div>
</BaseLayout>
