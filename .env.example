# Public URL used for canonical links, RSS, and the sitemap.
SITE_URL=https://ms802x.github.io

# Drafts are always visible in `npm run dev`; hidden in production builds unless true.
PUBLIC_INCLUDE_DRAFTS=false

# Optional comments via giscus (values from https://giscus.app).
PUBLIC_GISCUS_REPO=ms802x/ms802x.github.io
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Comments
PUBLIC_GISCUS_CATEGORY_ID=
