# Public URL used for canonical links, RSS, and the sitemap.
SITE_URL=https://ms802x.github.io

# Drafts are hidden in production builds unless this is true.
PUBLIC_INCLUDE_DRAFTS=false

# Client-side privacy gate. The password is hashed at build time; only the hash
# is shipped to the browser. This is visual privacy, not real access control.
SITE_GATE=true
SITE_PASSWORD=aalhejab
